{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeai-radar.local/schemas/state.schema.json",
  "title": "FreeAI Radar Persistent State",
  "description": "Compact public state persisted on the catalog-data branch. Contains schema_version, current normalized catalog, change log for the last 90 days and review records. Never contains raw HTML, cookies, secrets or local paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_version", "created_at", "updated_at", "runs", "sources", "snapshots", "providers", "models", "offers", "claims", "reviews", "changes", "collection_meta"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "state_version": { "type": "string", "pattern": "^sha256:[0-9a-f]{16,64}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "runs": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "job_type", "started_at", "finished_at", "outcome", "source_results"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "job_type": { "enum": ["collect", "build_only", "initial_import", "rollback"] },
          "started_at": { "type": "string" },
          "finished_at": { "type": "string" },
          "outcome": { "enum": ["success", "partial", "failed", "skipped"] },
          "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
          "source_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "status"],
              "properties": {
                "source_id": { "type": "string", "maxLength": 64 },
                "status": { "enum": ["ok", "not_modified", "failed", "parse_error", "skipped"] },
                "http_status": { "type": ["integer", "null"] },
                "record_count": { "type": ["integer", "null"] },
                "error": { "type": ["string", "null"], "maxLength": 300 }
              }
            }
          }
        }
      }
    },
    "sources": { "type": "array", "items": { "type": "object" } },
    "snapshots": {
      "type": "array",
      "maxItems": 4000,
      "description": "Only short evidence fragments, hashes and HTTP metadata. Full source pages are never persisted.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "fetched_at", "http_status", "content_hash"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "source_id": { "type": "string", "maxLength": 64 },
          "fetched_at": { "type": "string" },
          "http_status": { "type": ["integer", "null"] },
          "content_hash": { "type": "string", "maxLength": 80 },
          "etag": { "type": ["string", "null"], "maxLength": 200 },
          "last_modified": { "type": ["string", "null"], "maxLength": 100 },
          "extracted": { "type": "object" }
        }
      }
    },
    "providers": { "type": "array", "items": { "type": "object" } },
    "models": { "type": "array", "items": { "type": "object" } },
    "offers": { "type": "array", "items": { "type": "object" } },
    "claims": { "type": "array", "maxItems": 40000, "items": { "type": "object" } },
    "reviews": {
      "type": "array",
      "maxItems": 8000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim_fingerprint", "decision", "created_at", "scope"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "claim_id": { "type": ["string", "null"], "maxLength": 64 },
          "claim_fingerprint": {
            "type": "string",
            "maxLength": 80,
            "description": "Fingerprint over the verified field. If evidence fields change, the old review moves to needs_review."
          },
          "decision": { "enum": ["confirm", "reject", "supersede", "needs_review"] },
          "reason": { "type": ["string", "null"], "maxLength": 400 },
          "reviewer": { "type": ["string", "null"], "maxLength": 80 },
          "created_at": { "type": "string" },
          "evidence_url": { "type": ["string", "null"], "maxLength": 2048 },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "plan"],
            "properties": {
              "region": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
              "plan": { "type": ["string", "null"], "maxLength": 80 },
              "model_id": { "type": ["string", "null"], "maxLength": 200 }
            }
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 20000,
      "description": "Rolling 90-day window. Pruned by retention policy on every run.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fingerprint", "subject_type", "subject_id", "field", "change_type", "detected_at", "source_id", "confirmed"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "fingerprint": {
            "type": "string",
            "maxLength": 80,
            "description": "Idempotency fingerprint over (entity, field, old, new, evidence version). Re-running a collection adds nothing."
          },
          "subject_type": { "enum": ["provider", "model", "offer", "source"] },
          "subject_id": { "type": "string", "maxLength": 80 },
          "subject_label": { "type": ["string", "null"], "maxLength": 200 },
          "provider_id": { "type": ["string", "null"], "maxLength": 80 },
          "field": { "type": "string", "maxLength": 80 },
          "old_value": {},
          "new_value": {},
          "change_type": {
            "enum": [
              "initial_import",
              "new_provider",
              "new_model",
              "quota_changed",
              "condition_changed",
              "official_conflict",
              "promo_ended",
              "missing_from_source",
              "reappeared",
              "review_confirmed",
              "review_rejected"
            ]
          },
          "detected_at": { "type": "string" },
          "observed_at": { "type": "string" },
          "source_id": { "type": "string", "maxLength": 64 },
          "evidence_fingerprint": { "type": ["string", "null"], "maxLength": 80 },
          "evidence_ref": { "type": ["string", "null"], "maxLength": 2048 },
          "confirmed": { "type": "boolean" },
          "note": { "type": ["string", "null"], "maxLength": 400 }
        }
      }
    },
    "collection_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_successful_collection_at", "last_complete_collection_at", "initial_import_done", "retention_days", "null_result_streaks"],
      "properties": {
        "last_successful_collection_at": { "type": ["string", "null"] },
        "last_complete_collection_at": { "type": ["string", "null"] },
        "initial_import_done": { "type": "boolean" },
        "retention_days": { "type": "integer", "minimum": 30, "maximum": 400 },
        "null_result_streaks": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Consecutive runs where a source suddenly returned 0 records. Guards against announcing mass removal."
        }
      }
    }
  }
}
